# Optional to fill in by hand — you can also leave these blank and enter your
# key from the Vision OPS setup screen in the browser the first time you run it.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
PORT=3001
GROQ_TIMEOUT_MS=20000

# How many consecutive "needs_attention" frames in a row before a failure counts
# as confirmed (triggers the Discord webhook and printer auto-pause below).
CONFIRMATION_STREAK=3

# Optional: Discord incoming-webhook URL. Fires once per confirmed failure.
# Leave blank to disable notifications.
DISCORD_WEBHOOK_URL=

# Optional: automatically pause the machine on a confirmed failure.
# Set to "octoprint" or "moonraker", or leave as "none" to disable.
PRINTER_DRIVER=none
OCTOPRINT_URL=
OCTOPRINT_API_KEY=
MOONRAKER_URL=
