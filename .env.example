# Optional to fill in by hand — you can also leave these blank and enter your
# key from the Vision OPS setup screen in the browser the first time you run it.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
PORT=3001
GROQ_TIMEOUT_MS=20000

# How many consecutive "needs_attention" frames in a row before a failure counts
# as confirmed (triggers the Discord webhook and printer auto-pause below).
CONFIRMATION_STREAK=3

# ---------------------------------------------------------------------------
# Alerts. Both channels are optional and can be used together or on their own.
# Anything here can also be set from the app via POST /api/alerts.
# ---------------------------------------------------------------------------

# Discord incoming-webhook URL (Server Settings > Integrations > Webhooks).
# Leave blank to disable Discord messages.
DISCORD_WEBHOOK_URL=

# SMS to your phone, via Twilio. Get the SID and auth token from the Twilio
# console; TWILIO_FROM_NUMBER is a number you own there. On a Twilio trial
# account, ALERT_PHONE_NUMBER must be a verified number.
# Use TWILIO_MESSAGING_SERVICE_SID instead of TWILIO_FROM_NUMBER if you have a
# messaging service. Leave these blank to disable texts.
ALERT_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Which channels to use: auto (every channel with complete credentials),
# discord, sms, or both.
ALERT_CHANNELS=auto

# Minimum gap between repeats of the same alert, in milliseconds. Stops a stuck
# camera or a rate-limit storm from sending one text per frame. 0 disables.
ALERT_COOLDOWN_MS=300000

# Also alert on system errors (rejected API key, Groq outage, unreadable model
# output, failed auto-pause, crash) — not just on confirmed print failures.
ALERT_ON_ERRORS=true

# Optional: automatically pause the machine on a confirmed failure.
# Set to "octoprint" or "moonraker", or leave as "none" to disable.
PRINTER_DRIVER=none
OCTOPRINT_URL=
OCTOPRINT_API_KEY=
MOONRAKER_URL=
