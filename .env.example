# Optional to fill in by hand — you can also leave these blank and enter your
# key from the Vision OPS setup screen in the browser the first time you run it.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
PORT=3001
GROQ_TIMEOUT_MS=20000

# How many consecutive "needs_attention" frames in a row before a failure counts
# as confirmed (triggers the Discord webhook and printer auto-pause below).
CONFIRMATION_STREAK=3

# Discord incoming-webhook URL. This is the only thing you need to fill in to
# get alerts: Discord > Server Settings > Integrations > Webhooks > New Webhook
# > Copy Webhook URL. Leave blank to disable notifications entirely.
# Test it with: curl -X POST http://localhost:3001/api/notifications/test
DISCORD_WEBHOOK_URL=

# Who to ping on a confirmed failure or a crash. Use <@YOUR_USER_ID> for a DM-style
# ping, <@&ROLE_ID> for a role, or @here / @everyone. Leave blank for no ping.
# (Your user ID: enable Developer Mode in Discord, then right-click yourself > Copy User ID.)
DISCORD_MENTION=

# Also alert on runtime errors (Groq rejecting requests, rate limits, bad JSON,
# a printer that would not pause, a server crash) — not just print failures.
DISCORD_NOTIFY_ERRORS=true

# Post a follow-up when a camera that was in a confirmed failure goes back to normal.
DISCORD_NOTIFY_RECOVERY=true

# Attach the camera frame that triggered the failure to the Discord message.
DISCORD_ATTACH_SNAPSHOT=true

# Post a message when the server boots. Off by default to keep the channel quiet.
DISCORD_NOTIFY_STARTUP=false

# Anti-spam. Repeats of the same alert inside these windows are collapsed, and
# the suppressed count is reported on the next message that goes out.
DISCORD_ERROR_COOLDOWN_MS=300000
DISCORD_FAILURE_COOLDOWN_MS=120000

# Name the bot posts under.
DISCORD_USERNAME=Vision OPS

# Optional: automatically pause the machine on a confirmed failure.
# Set to "octoprint" or "moonraker", or leave as "none" to disable.
PRINTER_DRIVER=none
OCTOPRINT_URL=
OCTOPRINT_API_KEY=
MOONRAKER_URL=
